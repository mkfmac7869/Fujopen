rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Visa documents - authenticated users can upload, everyone can read
    match /visaDocuments/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Hotel images - authenticated users can upload, public can read
    match /hotelImages/{allPaths=**} {
      allow read: if true; // Public read for hotel images
      allow write: if isAuthenticated(); // Authenticated users can upload (UI protected by AdminRoute)
    }
    
    // Hotel invoices - authenticated users can read/write
    match /invoices/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // UI protected by AdminRoute
    }
    
    // Certificates - authenticated users can read/write
    match /certificates/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // UI protected by AdminRoute
    }
    
    // Documents - authenticated users can upload, everyone can read
    match /documents/{allPaths=**} {
      allow read: if true; // Public read for championship documents
      allow write: if isAuthenticated(); // UI protected by AdminRoute
    }
    
    // Team logos - authenticated users can upload, public can read
    match /teamLogos/{allPaths=**} {
      allow read: if true; // Public read
      allow write: if isAuthenticated();
    }
    
    // Profile pictures
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

