rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Visa documents - authenticated users can upload, everyone can read
    match /visaDocuments/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    // Hotel invoices - admins can create, authenticated users can read
    match /invoices/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Certificates - admins can create, authenticated users can read
    match /certificates/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Documents - admins can upload, everyone can read (NEW)
    match /documents/{allPaths=**} {
      allow read: if true; // Public read for championship documents
      allow write: if isAdmin(); // Only admins can upload
      allow delete: if isAdmin(); // Only admins can delete
    }
    
    // Profile pictures
    match /profilePictures/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth.uid == userId || isAdmin();
    }
  }
}

