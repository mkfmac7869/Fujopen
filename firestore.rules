rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Allow users to update their own data
    }
    
    // Visa applications
    match /visaApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Hotel bookings
    match /hotelBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Hotels
    match /hotels/{hotelId} {
      allow read: if true; // Public read
      allow write: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Transportation requests
    match /transportationRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Certificates
    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Document Categories
    match /documentCategories/{categoryId} {
      allow read: if true; // Public read so users can see categories
      allow write: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Documents
    match /documents/{documentId} {
      allow read: if true; // Public read so users can see documents
      allow write: if isAuthenticated(); // UI is protected by AdminRoute
    }
    
    // Folders (Visa Application Folders)
    match /folders/{folderId} {
      allow read, write: if isAuthenticated(); // UI is protected by AdminRoute
      
      // Folder applications subcollection
      match /applications/{applicationId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // UI is protected by AdminRoute
    }
  }
}

