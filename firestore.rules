rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if request.auth.uid == userId || isAdmin();
    }
    
    // Visa applications
    match /visaApplications/{applicationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Hotel bookings
    match /hotelBookings/{bookingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Hotels
    match /hotels/{hotelId} {
      allow read: if true; // Public read
      allow write: if isAdmin();
    }
    
    // Transportation requests
    match /transportationRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // Certificates
    match /certificates/{certificateId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Document Categories (NEW)
    match /documentCategories/{categoryId} {
      allow read: if true; // Public read so users can see categories
      allow write: if isAdmin(); // Only admins can create/update/delete categories
    }
    
    // Documents (NEW)
    match /documents/{documentId} {
      allow read: if true; // Public read so users can see documents
      allow write: if isAdmin(); // Only admins can upload/update/delete documents
    }
    
    // Folders
    match /folders/{folderId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}

